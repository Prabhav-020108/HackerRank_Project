# ---------------------------------------------------------
# Google AI Studio Configuration
# ---------------------------------------------------------

# Standard single-key fallback (For automated evaluation scripts)
GEMINI_API_KEY="your_api_key_here"

# ---------------------------------------------------------
# Local Developer Configuration (Optional)
# ---------------------------------------------------------
# To bypass free-tier rate limits during local testing, you can provide 
# multiple API keys separated by commas. The system will automatically 
# load-balance and rotate between them if a 429 quota error occurs.
# GEMINI_API_KEYS="key_1,key_2,key_3"

GEMINI_MODEL="gemini-2.0-flash"
